<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appToastRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:background="@drawable/app_toast_background"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appToastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="6"
            android:textColor="#F5F8FC"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/appToastCopyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_toast_copy_hint"
            android:textColor="#9FB0C2"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/appToastCopyButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/modern_dialog_secondary_button_background"
        android:minWidth="72dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:stateListAnimator="@null"
        android:text="@string/app_toast_copy"
        android:textAllCaps="false"
        android:textColor="#DCE6F1"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/appToastDismissButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/app_toast_dismiss"
        android:padding="6dp"
        android:src="@drawable/ic_close" />
</LinearLayout>
