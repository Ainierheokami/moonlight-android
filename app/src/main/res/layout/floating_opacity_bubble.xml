<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/modern_dialog_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/vk_float_opacity"
        android:src="@drawable/ic_opacity" />

    <SeekBar
        android:id="@+id/opacity_seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/vk_float_opacity"
        android:progressTint="#1AA7EC"
        android:thumbTint="#1AA7EC" />

    <TextView
        android:id="@+id/opacity_value"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#F5F8FC"
        android:textSize="12sp" />
</LinearLayout>
