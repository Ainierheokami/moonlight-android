<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        设置页主题：通过 preference*Style 把所有设置项（包括自定义 Preference 子类）
        统一换成卡片布局，复选框统一显示为开关。
    -->
    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:colorAccent">@color/settings_accent</item>
        <item name="android:preferenceStyle">@style/SettingsPreference</item>
        <item name="android:preferenceCategoryStyle">@style/SettingsPreference.Category</item>
        <item name="android:checkBoxPreferenceStyle">@style/SettingsPreference.Switch</item>
        <item name="android:dialogPreferenceStyle">@style/SettingsPreference.Dialog</item>
        <item name="android:editTextPreferenceStyle">@style/SettingsPreference.EditText</item>
    </style>

    <style name="SettingsPreference" parent="@android:style/Preference">
        <item name="android:layout">@layout/settings_pref_item</item>
    </style>

    <style name="SettingsPreference.Category" parent="@android:style/Preference.Category">
        <item name="android:layout">@layout/settings_pref_category</item>
    </style>

    <style name="SettingsPreference.Switch" parent="@android:style/Preference.CheckBoxPreference">
        <item name="android:layout">@layout/settings_pref_item</item>
        <item name="android:widgetLayout">@layout/settings_pref_switch</item>
    </style>

    <!-- 保留父样式中的确定/取消按钮文字，只替换布局 -->
    <style name="SettingsPreference.Dialog" parent="@android:style/Preference.DialogPreference">
        <item name="android:layout">@layout/settings_pref_item</item>
    </style>

    <style name="SettingsPreference.EditText" parent="@android:style/Preference.DialogPreference.EditTextPreference">
        <item name="android:layout">@layout/settings_pref_item</item>
    </style>
</resources>
