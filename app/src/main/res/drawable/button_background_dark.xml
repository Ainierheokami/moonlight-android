<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_surface_pressed" />
            <corners android:radius="@dimen/menu_item_radius" />
            <stroke android:width="1dp" android:color="@color/menu_stroke_strong" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_surface_pressed" />
            <corners android:radius="@dimen/menu_item_radius" />
            <stroke android:width="1dp" android:color="@color/menu_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_surface_raised" />
            <corners android:radius="@dimen/menu_item_radius" />
            <stroke android:width="1dp" android:color="@color/menu_stroke" />
        </shape>
    </item>
</selector>
