<?xml version="1.0" encoding="utf-8"?>
<!-- Single-choice dialog row: the checked row (state_activated) gets an accent fill/stroke so
     the selection is visible before the user taps Apply. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_pressed="true">
        <shape>
            <solid android:color="#1B4A68" />
            <stroke android:width="2dp" android:color="#1AA7EC" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#16384F" />
            <stroke android:width="2dp" android:color="#1AA7EC" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#263241" />
            <stroke android:width="1dp" android:color="#3E5166" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#18212C" />
            <stroke android:width="1dp" android:color="#2A3747" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
